package build

import mill.*
import mill.javalib.publish.{Developer, License, PomSettings, VersionControl}
import mill.scalalib.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.scalanativelib.*
import mill.scalanativelib.api.{LTO, ReleaseMode}
import mill.contrib.jmh.JmhModule

object Versions:
  val scala       = "3.9.0"
  val munit       = "1.1.1"
  val scalaJs     = "1.22.0"
  val scalaNative = "0.5.12"

trait BaseModule extends ScalaModule:
  def scalaVersion  = Versions.scala
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked")

  // scala-cli runs of the example scripts leave generated sources under a .scala-build dir
  override def allSourceFiles = Task {
    super.allSourceFiles().filter(!_.path.segments.contains(".scala-build"))
  }

trait BaseJsModule extends BaseModule, ScalaJSModule:
  def scalaJSVersion = Versions.scalaJs

trait BaseJsWasmModule extends BaseJsModule:
  override def moduleKind: T[ModuleKind]             = Task { ModuleKind.ESModule }
  override def moduleSplitStyle: T[ModuleSplitStyle] = Task { ModuleSplitStyle.FewestModules }
  override def scalaJSExperimentalUseWebAssembly: T[Boolean] = Task { true }
  // the Wasm backend requires ES2022 since Scala.js 1.22 (needs mill > 1.2.0-RC1 for the enum case)
  override def esFeatures = Task { super.esFeatures().withESVersion(ESVersion.ES2022) }

trait BaseNativeModule extends BaseModule, ScalaNativeModule:
  def scalaNativeVersion = Versions.scalaNative

trait PublishSettings extends PublishModule, mill.util.VcsVersionModule:
  def pomSettings = PomSettings(
    description = "command-line argument parsing for Scala 3, derived from plain data declarations",
    organization = "io.github.bishabosha",
    url = "https://github.com/bishabosha/flagged",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("bishabosha", "flagged"),
    developers = Seq(
      Developer(
        "bishabosha",
        "Jamie Thompson",
        "https://bishabosha.github.io",
        email = "thompsonjamesrichard@gmail.com"
      )
    )
  )

/** Adds the `src-jvm-native` folder holding sources shared by the JVM and Native platforms. */
trait JvmNativeSources extends JavaModule:
  override def sourcesFolders = super.sourcesFolders ++ Seq(os.sub / "src-jvm-native")

/** Rewrites the capture-checked sources into their unchecked equivalent, compiled and published by
  * [[flagged.stable]]. The checked modules are the single source of truth and verify the mutation
  * discipline; the stable variant must carry no experimental API in bytecode or TASTy, so this
  * strips the experimental language imports, `update` modifiers, capture annotations (`^`,
  * `^{...}`), `consume` modifiers, the `caps.Mutable` parents, and `@untrackedCaptures`; rewrites
  * pure function arrows (`->`) to `=>`; and turns the identity wrappers `caps.freeze` and
  * `caps.unsafe.unsafeAssumeSeparate` into `locally`. Any capture-checking construct it does not
  * recognise fails the build rather than leaking into the published artifact.
  */
object Uncheck:
  private def wholeFile(s: String): String =
    var t = s
    t = t.replaceAll(raw",\s*caps\.Mutable", "")
    t = t.replaceAll(raw"\s+extends\s+caps\.Mutable(?=\s*:)", "")
    t = t.replaceAll(raw"caps\.unsafe\s*\.\s*unsafeAssumeSeparate\(", "locally(")
    // the `frozen` indirection: its body `caps.freeze(x)` reduces to the argument itself (simple
    // paths only — a complex direct `caps.freeze` argument trips the guard; call `frozen` instead)
    t = t.replaceAll(raw"caps\.freeze\(([\w.]+)\)", "$1")
    // `frozen`'s domain: a Mutable object is an ordinary AnyRef once the marker trait is
    // stripped, so the derived signature must accept any reference, not just arrays
    t = t.replaceAll(raw"caps\.Mutable\s*\|\s*Array\[\?\]", "AnyRef")
    t

  private val forbidden =
    raw"(?:caps\.|\^\{|\s->\s|\b(?:update|consume)\s+def\b|language\.experimental\.(?:captureChecking|separationChecking))".r

  // capture-checking imports are dropped (blanked, keeping line numbers stable): everything a
  // checked file could import from `scala.caps` is stripped or rewritten by the rules below, and
  // in-code capture-checking constructs must be spelled `caps.`-qualified for the rules to see
  // them — an unqualified spelling survives conversion and is caught by the uncheck-plugin at
  // stable-compile time instead
  private val droppedImport =
    raw"import\s+(?:language\.experimental\.(?:captureChecking|separationChecking)|(?:scala\.)?caps\b.*)".r

  private def codeLine(c0: String): String =
    var c = c0
    c = c.replaceAll(raw"@scala\.caps\.unsafe\.untrackedCaptures\s+", "")
    c = c.replaceAll(raw"\^\{[^}]*\}", "")
    c = c.replaceAll(raw"(?<=[\w\)\]])\^(?![\w])", "")
    c = c.replace(" -> ", " => ")
    c = c.replaceAll(raw"\bupdate\s+(?=def\b)", "")
    c = c.replaceAll(raw"\bconsume\s+(?=def\b)", "")
    // parameter form: `def f(consume x: T)` — a parameter *named* consume (`consume: T`) has no
    // whitespace after the word, so it is left alone
    c = c.replaceAll(raw"\bconsume\s+(?=`?\w+\s*:)", "")
    c

  /** Files that do not enable capture checking pass through unchanged — in particular their
    * term-level `->` tuple builders. Checked sources must avoid the `->` tuple builder (use a tuple
    * literal), since in those files `->` is rewritten as the pure function arrow.
    */
  def convert(path: String, text: String): String =
    if !text.contains("import language.experimental.captureChecking") then return text
    wholeFile(text).linesWithSeparators.zipWithIndex.map { case (line, i) =>
      val trimmed = line.trim
      if trimmed.startsWith("//") || trimmed.startsWith("*") || trimmed.startsWith("/*") then line
      else if droppedImport.matches(trimmed) then
        line.takeRight(if line.endsWith("\r\n") then 2 else 1)
      else
        val cut  = line.indexOf(" // ")
        val code = if cut < 0 then line else line.take(cut)
        val tail = if cut < 0 then "" else line.drop(cut)
        val out  = codeLine(code)
        forbidden.findFirstIn(out).foreach { m =>
          sys.error(s"Uncheck: unconverted capture-checking construct '$m' at $path:${i + 1}")
        }
        out + tail
    }.mkString

/** Compiles the [[flagged.uncheck.UncheckPlugin]] compiler plugin: the semantic guard applied to
  * every `flagged.stable` compilation. The textual [[Uncheck]] rewrite is best-effort; the plugin
  * rejects whatever it might miss (aliased imports, fully-qualified references, inferred types,
  * `retains` annotations, `update`-flagged methods) at the resolved-symbol level.
  */
object `uncheck-plugin` extends BaseModule:
  def compileMvnDeps = Seq(mvn"org.scala-lang::scala3-compiler:${Versions.scala}")

object flagged extends Module:
  trait FlaggedModule extends BaseModule, PlatformScalaModule:
    def mvnDeps = Seq(mvn"ch.epfl.lamp::steps::0.2.1")

    // test modules inherit the outer module's source folder names (src, src-jvm, ...)
    trait FlaggedTests extends ScalaTests, TestModule.Munit:
      def munitVersion = Versions.munit

  object jvm extends FlaggedModule, JvmNativeSources:
    object test extends FlaggedTests:
      // WarningsSuite (test/src-jvm) drives the dotty compiler to assert emitted diagnostics
      def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.scala-lang::scala3-compiler:${Versions.scala}")

  object js extends FlaggedModule, BaseJsModule:
    object test extends FlaggedTests, ScalaJSTests

  object jsWasm extends FlaggedModule, BaseJsWasmModule:
    override def platformCrossSuffix = "js"

  object native extends FlaggedModule, BaseNativeModule, JvmNativeSources:
    object test extends FlaggedTests, ScalaNativeTests

  /** The published library: the checked twin's sources, mechanically rewritten by [[Uncheck]] and
    * compiled without any experimental feature. Runs the same test suites as the checked modules.
    */
  object stable extends Module:
    trait StableModule extends BaseModule, PublishSettings:
      def artifactName = "flagged"
      def mvnDeps      = Seq(mvn"ch.epfl.lamp::steps::0.2.1")

      override def scalacOptions = Task {
        super.scalacOptions() :+ s"-Xplugin:${`uncheck-plugin`.jar().path}"
      }

      /** The checked twin whose source folders this module rewrites. */
      def checked: ScalaModule

      override def sources = Task {
        checked.sources().zipWithIndex.map { case (ref, i) =>
          val dest = Task.dest / i.toString
          if os.exists(ref.path) then
            for p <- os.walk(ref.path) if os.isFile(p) && p.ext == "scala" do
              val rel = p.relativeTo(ref.path)
              os.write(
                dest / rel,
                Uncheck.convert(p.toString, os.read(p)),
                createFolders = true
              )
          PathRef(dest)
        }
      }

      /** Runs the checked twin's test sources against the rewritten library. */
      trait StableTests extends ScalaTests, TestModule.Munit:
        def munitVersion = Versions.munit
        def checkedTest: ScalaModule
        override def sources = Task { checkedTest.sources() }

        // the guard also covers inline expansion: library inline bodies are re-typechecked here
        override def scalacOptions = Task {
          super.scalacOptions() :+ s"-Xplugin:${`uncheck-plugin`.jar().path}"
        }

    object jvm extends StableModule:
      def checked = flagged.jvm
      object test extends StableTests:
        def checkedTest = flagged.jvm.test
        // the shared WarningsSuite drives the dotty compiler to assert emitted diagnostics
        def mvnDeps = super.mvnDeps() ++
          Seq(mvn"org.scala-lang::scala3-compiler:${Versions.scala}")

    object js extends StableModule, BaseJsModule:
      def checked = flagged.js
      object test extends StableTests, ScalaJSTests:
        def checkedTest = flagged.js.test

    object native extends StableModule, BaseNativeModule:
      def checked = flagged.native
      object test extends StableTests, ScalaNativeTests:
        def checkedTest = flagged.native.test

/** Puts flagged on the run classpath as its packaged jar instead of a directory of class files, so
  * benchmarks see the library the way a project resolving it from a Maven repository would —
  * mainargs and case-app are already jars from the coursier cache. CompileBench hands this
  * classpath to the dotty driver, so it also governs where the compiler reads flagged's TASTy.
  */
trait FlaggedFromJar extends JavaModule:
  override def runClasspath = Task {
    val local =
      (flagged.stable.jvm.localRunClasspath() ++ flagged.stable.jvm.compileResources())
        .map(_.path)
        .toSet
    super.runClasspath().filterNot(ref => local(ref.path)) :+ flagged.stable.jvm.jar()
  }

object `bench-portable` extends Module:
  trait BenchPortableModule extends BaseModule, PlatformScalaModule:
    def mvnDeps = Seq(
      mvn"com.lihaoyi::mainargs::0.7.8",
      mvn"com.github.alexarchambault::case-app::2.1.0"
    )

  object jvm extends BenchPortableModule, FlaggedFromJar:
    def moduleDeps = Seq(flagged.stable.jvm)

  object js extends BenchPortableModule, BaseJsModule:
    def moduleDeps = Seq(flagged.stable.js)

  object jsWasm extends BenchPortableModule, BaseJsWasmModule:
    override def platformCrossSuffix = "js"
    def moduleDeps                   = Seq(flagged.jsWasm)

  object native extends BenchPortableModule, BaseNativeModule:
    def moduleDeps                           = Seq(flagged.stable.native)
    override def releaseMode: T[ReleaseMode] = Task { ReleaseMode.ReleaseFast }

  /** The recommended Native release configuration measured as "Native (max)" in `bench/results.md`:
    * release-full, thin LTO, no GC (sound for a parse-once-and-exit CLI).
    */
  object nativeMax extends BenchPortableModule, BaseNativeModule:
    override def platformCrossSuffix         = "native"
    def moduleDeps                           = Seq(flagged.stable.native)
    override def releaseMode: T[ReleaseMode] = Task { ReleaseMode.ReleaseFull }
    override def nativeLTO: T[LTO]           = Task { LTO.Thin }
    override def nativeGC: T[String]         = Task { "none" }

object bench extends BaseModule, JmhModule, FlaggedFromJar:
  def jmhCoreVersion = "1.37"
  def moduleDeps     = Seq(`bench-portable`.jvm)
  def mvnDeps        = super.mvnDeps() ++ Seq(
    mvn"org.scala-lang::scala3-compiler:${Versions.scala}",
    // realistic-scenario runtime rows only: builder/reflection libraries with no
    // derivation to measure at compile time (picocli is Java, JVM-only)
    mvn"com.github.scopt::scopt:4.1.0",
    mvn"org.rogach::scallop:5.1.0",
    mvn"info.picocli:picocli:4.7.6"
  )

object examples extends BaseModule:
  def moduleDeps = Seq(flagged.stable.jvm)

/** Derives the unchecked publishable branch: creates `branch` from `base` (or reuses it if it
  * already exists), mirrors the current working tree onto it — documentation, benchmarks, examples,
  * CI config: everything except each branch's own build files — then replaces the flagged source
  * folders with the [[Uncheck]] rewrite of the checked sources, strips the capture-checked-only
  * region from `.scalafmt.conf`, adds the README derivation notice, reformats the result, and
  * commits. If the branch is already checked out in another (clean) worktree, the commit is made
  * there so that checkout stays in sync; otherwise all work happens in a temporary git worktree and
  * the current checkout is untouched.
  *
  * The commit message lists the PRs merged to `prBranch` (default: the current branch) since the
  * last sync of `branch` into `base`: the newest derive commit reachable from `base` records the
  * source revision it was generated from, and PRs merged after that revision are listed — all of
  * them when `base` carries no derive commit yet.
  */
def deriveStable(
    branch: String = "mutable-spec-stable",
    base: String = "main",
    prBranch: Option[String] = None
): Command[String] = Task.Command {
  val repo = moduleDir

  def git(args: String*): os.CommandResult =
    os.proc("git", args).call(cwd = repo)

  val head         = git("rev-parse", "--short", "HEAD").out.trim()
  val sourceBranch = git("rev-parse", "--abbrev-ref", "HEAD").out.trim()
  val dirty        = git("status", "--porcelain").out.trim().nonEmpty

  // checked source folder name -> its converted counterpart (the shared `src` folder appears
  // once per platform with identical content, so keep any one of them)
  val generated: Map[String, os.Path] =
    Seq(
      (flagged.jvm.sources(), flagged.stable.jvm.sources()),
      (flagged.js.sources(), flagged.stable.js.sources()),
      (flagged.native.sources(), flagged.stable.native.sources())
    ).flatMap((c, g) => c.map(_.path).zip(g.map(_.path)))
      .groupMapReduce((c, _) => c.last)((_, g) => g)((a, _) => a)

  // outside the repository: under out/ the derived scalafmt config's own `**/out/**`
  // exclusion would skip every file during the reformat step
  if branch == sourceBranch then
    sys.error(s"refusing to derive onto the currently checked-out branch '$branch'")

  def resolves(rev: String): Boolean =
    os.proc("git", "rev-parse", "--verify", "--quiet", s"$rev^{commit}")
      .call(cwd = repo, check = false)
      .exitCode == 0

  // PRs merged to `prBranch` since the last sync into `base`, for the commit message: the
  // newest derive commit reachable from `base` (it arrives there via the `branch` -> `base`
  // sync PR) records the source revision it was generated from. If that revision is missing
  // (no sync yet, or it was rebased away), every PR merge reachable from `prBranch` is listed
  val prSource = prBranch.getOrElse(sourceBranch)
  val prevRev  =
    Option
      .when(resolves(base)) {
        os.proc(
          "git",
          "log",
          "-1",
          "--grep=Generated by `mill deriveStable` from",
          "--format=%b",
          base
        ).call(cwd = repo)
          .out
          .text()
      }
      .flatMap(raw"from \S+?@([0-9a-f]+)".r.findFirstMatchIn(_))
      .map(_.group(1))
      .filter(resolves)
  val prLines: Seq[String] =
    val mergeRe  = raw"Merge pull request #(\d+) from .+".r
    val squashRe = raw"(.+) \(#(\d+)\)".r
    val range    = prevRev.fold(prSource)(_ + ".." + prSource)
    git("log", "--first-parent", "--format=%x1e%s%x1f%b", range).out
      .text()
      .split('\u001e')
      .iterator
      .map(_.trim)
      .filter(_.nonEmpty)
      .flatMap { record =>
        val parts   = record.split('\u001f')
        val subject = parts(0).trim
        val body    = if parts.length > 1 then parts(1) else ""
        subject match
          // a GitHub merge commit carries the PR title as its body
          case mergeRe(num) =>
            Some(s"- ${body.linesIterator.map(_.trim).find(_.nonEmpty).getOrElse(subject)} (#$num)")
          case squashRe(title, num) => Some(s"- $title (#$num)")
          case _                    => None
      }
      .toSeq
  val prSummary =
    if prLines.isEmpty then ""
    else
      s"\n\nMerged PRs on $prSource${prevRev.fold("")(" since " + _)}:\n${prLines.mkString("\n")}"

  // stale registrations (e.g. an interrupted run whose temp dir is gone) block `worktree add`
  git("worktree", "prune")
  val checkedOutAt: Option[os.Path] =
    git("worktree", "list", "--porcelain").out
      .text()
      .split("\n\n")
      .find(_.linesIterator.exists(_ == s"branch refs/heads/$branch"))
      .map(block => os.Path(block.linesIterator.next().stripPrefix("worktree ")))

  // when the branch is already checked out somewhere, commit on top of it in that worktree —
  // updating the ref behind a checkout would desync it — but only if it is clean
  val (wt, temporary) = checkedOutAt match
    case Some(at) =>
      if os.proc("git", "status", "--porcelain").call(cwd = at).out.trim().nonEmpty then
        sys.error(
          s"branch '$branch' is checked out at $at with uncommitted changes — commit or stash them first"
        )
      (at, false)
    case None =>
      val wt     = os.temp.dir(prefix = "flagged-derive") / "worktree"
      val exists =
        os.proc("git", "rev-parse", "--verify", "--quiet", branch)
          .call(cwd = repo, check = false)
          .exitCode == 0
      if exists then git("worktree", "add", wt.toString, branch)
      else git("worktree", "add", wt.toString, "-b", branch, base)
      (wt, true)
  try
    // each branch keeps its own build definition (this branch's build carries the
    // capture-checking setup and this task; the derived branch's build compiles the plain
    // sources) — so these are neither copied from the source branch nor deleted on the target;
    // `.claude` is local tool configuration, likewise left alone
    val branchSpecific =
      Seq("build.mill", "mill", "mill.bat", ".mill-version", "uncheck-plugin", ".claude")

    // mirror the working tree (tracked and untracked-but-not-ignored files): delete-then-copy
    // so files removed on the source branch also disappear from the derived branch (`git rm`
    // prunes emptied directories)
    os.proc("git", "rm", "-rq", "--", ".", branchSpecific.map(p => s":(exclude)$p"))
      .call(cwd = wt)
    for
      rel <- git("ls-files", "--cached", "--others", "--exclude-standard").out.lines()
      p = os.RelPath(rel)
      if !branchSpecific.contains(p.segments.head)
      if os.isFile(repo / p) // --cached lists files even when deleted in a dirty working tree
    do os.copy.over(repo / p, wt / p, createFolders = true)

    for (name, gen) <- generated do
      val target = wt / "flagged" / name
      os.remove.all(target)
      os.copy(gen, target, createFolders = true)

    val conf        = os.read(repo / ".scalafmt.conf")
    val derivedConf =
      conf.replaceAll(
        raw"(?s)\n?# BEGIN capture-checked-only settings.*?# END capture-checked-only settings[^\n]*\n?",
        ""
      ) +
        "\n# build outputs (including sources generated by other branches' builds) are not format-checked\n" +
        "project.excludePaths = [\"glob:**/out/**\"]\n"
    os.write.over(wt / ".scalafmt.conf", derivedConf)

    val noticeHeader = "## Derived sources"
    val notice       =
      s"""$noticeHeader
         |
         |This branch is mechanically derived from the
         |[`$sourceBranch`](https://github.com/bishabosha/flagged/tree/$sourceBranch) branch — the development
         |branch, where the parser engine and other mutable internals are verified under the experimental
         |`captureChecking` and `separationChecking` language modes. Everything except the build files
         |(`build.mill`, the mill launcher, and the `uncheck-plugin` compiler plugin) is mirrored from
         |there: documentation, benchmarks, and examples verbatim, and the library sources via the
         |`Uncheck` rewrite in that branch's `build.mill`, which strips the capture-checking surface — the
         |language imports, `update`/`consume` modifiers, capture annotations (`^`, `^{...}`, `->`), and
         |`caps.*` calls — so the published artifacts carry no dependency on experimental standard-library
         |API. Make changes on `$sourceBranch` and re-derive them with `mill deriveStable` rather than
         |editing this branch directly.
         |""".stripMargin
    val readmePath = wt / "README.md"
    val readme     = os.read(readmePath)
    val updated    =
      if readme.contains(noticeHeader) then
        readme.replaceAll(raw"(?s)## Derived sources\n.*?(?=\n## )", notice)
      else
        val at = readme.indexOf("\n## ")
        if at < 0 then readme + "\n" + notice
        else readme.take(at + 1) + notice + "\n" + readme.drop(at + 1)
    os.write.over(readmePath, updated)

    val toFormat =
      os.walk(wt / "flagged")
        .filter(p => os.isFile(p) && p.ext == "scala")
        .map(PathRef(_))
    mill.scalalib.scalafmt.ScalafmtWorkerModule
      .worker()
      .reformat(toFormat, PathRef(wt / ".scalafmt.conf"))

    // the mirror stages deletions via `git rm`, so stage everything before deciding whether
    // anything actually changed (a file deleted and restored identical nets out clean)
    os.proc("git", "add", "-A").call(cwd = wt)
    if os.proc("git", "status", "--porcelain").call(cwd = wt).out.trim().isEmpty then
      s"$branch is already up to date with $sourceBranch@$head"
    else
      val fromRev = s"$sourceBranch@$head" + (if dirty then " (dirty working tree)" else "")
      os.proc(
        "git",
        "commit",
        "-m",
        s"derive from $sourceBranch\n\nGenerated by `mill deriveStable` from $fromRev: the working tree mirrored except build files, with library sources via the Uncheck rewrite.$prSummary"
      ).call(cwd = wt)
      val sha = os.proc("git", "rev-parse", "--short", "HEAD").call(cwd = wt).out.trim()
      s"derived $branch@$sha from $fromRev (base $base)"
  finally
    if temporary then
      os.proc("git", "worktree", "remove", "--force", wt.toString).call(cwd = repo, check = false)
      os.remove.all(wt / os.up)
}
